<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario en Android 13+ para mostrar notificaciones -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Actividad principal: registro de solicitudes -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Formulario de solicitud de envío de encomienda -->
        <activity
            android:name=".SolicitudActivity"
            android:exported="false"
            android:label="@string/title_solicitud"
            android:parentActivityName=".MainActivity" />

        <!-- Características del envío -->
        <activity
            android:name=".CaracteristicasActivity"
            android:exported="false"
            android:label="@string/title_caracteristicas"
            android:parentActivityName=".MainActivity" />
    </application>
</manifest>
